# Karo — Umgebungsvariablen für .env (neben docker-compose.yml)
# Diese Datei ist ein Beispiel: leere Werte sind absichtlich leer.
# `.env` steht in .gitignore und wird nie eingecheckt.

# KI-Anbieter: externer Provider für Erklärungen, Themenvorschläge und
# Prüfungen. Welcher aktiv ist, steht in /data/config.json ("ai_provider",
# Standard "devin" — alternativ "openrouter", siehe docs/CONFIG.md).
# Der Schlüssel des jeweils aktiven Anbieters wird ausschließlich aus
# seiner Umgebungsvariable gelesen und NIE in /data/config.json
# gespeichert.
DEVIN_API_KEY=
# Nur nötig, wenn "ai_provider": "openrouter" gesetzt ist
# (zusätzlich KARO_AI_OPENROUTER_MODEL=<modell> setzen):
# OPENROUTER_API_KEY=

# Pfad zum Google-Drive-Ordner (Drive-Desktop-Client synchronisiert ihn).
# Ohne diesen Wert landet Karo in ./drive-lokal.
KARO_DRIVE_PATH=

# Optional: eigener Ort für die NotebookLM-Session (siehe README).
KARO_NOTEBOOKLM_HOME=

# Optional: externer Curriculum-Dienst (siehe docs/API_INVENTORY.md).
# Wird der Dienst genutzt, gehört der Schlüssel hierher — er ist ein Secret.
KARO_CURRICULUM_URL=
KARO_CURRICULUM_KEY=

# Optional: Build-Flags (nur für docker-compose.build.yml / make up-klein).
KARO_MIT_MP4=1
KARO_MIT_NOTEBOOKLM=1

# Betriebsparameter: jeder Ops-Wert aus docs/CONFIG.md lässt sich hier
# überschreiben (KARO_<FELD>). Beispiele — auskommentiert, Defaults aktiv:
# KARO_LOG_LEVEL=INFO
# KARO_UPLOAD_MAX_BYTES=26214400
# KARO_PAKET_MAX_SEITEN=10
# KARO_AI_POLL_SECONDS=45
# KARO_OCR_SPRACHEN=deu+eng
# KARO_TIMEZONE=Europe/Berlin

# Secrets stehen NICHT hier — mit Ausnahme der Provider-Schlüssel und
# KARO_CURRICULUM_KEY (Kommentare oben) liegen sie gar nicht in Dateien:
# Passwort-Hashes und session.key entstehen im /data-Volume.
