+/* „Meine Woche" — eigenes Aussehen, bewusst nicht Karos.
+ *
+ * Grundsaetze: ein Bildschirm, eine Handlung. Grosse Ziele fuer Daumen.
+ * Nichts blinkt, nichts zaehlt hoch, nichts wird rot. Ruhig genug, dass ein
+ * gestresstes Kind es abends aufmacht.
+ */
+
+:root {
+  color-scheme: light;
+  --grund: #fbf7f2;
+  --karte: #ffffff;
+  --rand: #e8e0d6;
+  --text: #2a2622;
+  --leise: #7c7168;
+  --haupt: #3f7d6e;
+  --haupt-text: #ffffff;
+  --still: #f1ece5;
+  --akzent: #e8a33d;
+  --radius: 20px;
+  --schatten: 0 2px 10px rgba(60, 45, 30, .07);
+}
+
+@media (prefers-color-scheme: dark) {
+  :root {
+    color-scheme: dark;
+    --grund: #1a1815;
+    --karte: #242019;
+    --rand: #38322a;
+    --text: #f0ebe4;
+    --leise: #a89d92;
+    --haupt: #5aa694;
+    --haupt-text: #10201c;
+    --still: #2e2820;
+    --akzent: #e8a33d;
+    --schatten: none;
+  }
+}
+
+* { box-sizing: border-box; }
+
+body {
+  margin: 0;
+  padding: env(safe-area-inset-top, 0) 0 calc(76px + env(safe-area-inset-bottom, 0));
+  background: var(--grund);
+  color: var(--text);
+  font: 17px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
+  -webkit-text-size-adjust: 100%;
+}
+
+main {
+  max-width: 34rem;
+  margin: 0 auto;
+  padding: 20px 16px 8px;
+}
+
+h1 { font-size: 1.6rem; line-height: 1.25; margin: 0 0 .6rem; }
+h2 { font-size: 1.05rem; margin: 1.6rem 0 .5rem; }
+p { margin: 0 0 .7rem; }
+a { color: var(--haupt); }
+
+.leise { color: var(--leise); }
+.klein { font-size: .85rem; }
+.gross-text { font-size: 1.25rem; line-height: 1.4; }
+
+/* --- Karten ------------------------------------------------------------ */
+
+.karte {
+  background: var(--karte);
+  border: 1px solid var(--rand);
+  border-radius: var(--radius);
+  padding: 18px;
+  margin: 0 0 18px;
+  box-shadow: var(--schatten);
+}
+.karte.fertig { opacity: .55; }
+.karte.ruhig { background: var(--still); box-shadow: none; }
+
+/* --- Heute: die eine Sache --------------------------------------------- */
+
+main.heute { display: flex; flex-direction: column; min-height: 62vh; justify-content: center; }
+
+.heute-karte {
+  background: var(--karte);
+  border: 1px solid var(--rand);
+  border-radius: 26px;
+  padding: 28px 22px;
+  text-align: center;
+  box-shadow: var(--schatten);
+}
+.heute-karte.ruhig { background: var(--still); }
+.heute-karte h1 { font-size: 1.5rem; }
+.heute-karte .fach {
+  color: var(--leise); font-size: .85rem; text-transform: uppercase;
+  letter-spacing: .08em; margin: 0 0 .4rem;
+}
+
+.avatar {
+  display: block; width: 64px; height: 64px; margin: 0 auto 14px;
+  border-radius: 50%; object-fit: cover; background: var(--still);
+  font-size: 34px; line-height: 64px; text-align: center;
+}
+.avatar.gross { width: 92px; height: 92px; font-size: 48px; line-height: 92px; }
+
+/* --- Knoepfe ----------------------------------------------------------- */
+
+button, .knopf {
+  font: inherit; cursor: pointer; border-radius: 14px;
+  border: 1px solid var(--rand); background: var(--karte); color: var(--text);
+  padding: 12px 18px; text-decoration: none; display: inline-block;
+}
+button:active, .knopf:active { transform: translateY(1px); }
+
+.gross {
+  display: block; width: 100%; padding: 17px 18px; margin: 10px 0 0;
+  font-size: 1.05rem; font-weight: 600; text-align: center;
+}
+.haupt { background: var(--haupt); color: var(--haupt-text); border-color: var(--haupt); }
+.still { background: var(--still); }
+button.linklike {
+  background: none; border: none; color: var(--leise);
+  text-decoration: underline; padding: 10px 4px;
+}
+.knopfreihe { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 10px; }
+.knopfreihe > * { flex: 1 1 auto; }
+.inline { display: inline; }
+.liste { display: flex; flex-direction: column; }
+
+/* --- Smileys ----------------------------------------------------------- */
+
+.smileys { display: flex; gap: 10px; margin-top: 14px; }
+.smileys button {
+  flex: 1; display: flex; flex-direction: column; gap: 6px; align-items: center;
+  padding: 18px 6px; font-size: .9rem; color: var(--leise);
+}
+.smileys b { font-size: 2rem; }
+
+/* --- Chips ------------------------------------------------------------- */
+
+.chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 14px; }
+.chip { position: relative; }
+.chip input { position: absolute; opacity: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
+.chip span, .chip-knopf {
+  display: inline-block; padding: 9px 14px; border-radius: 999px;
+  border: 1px solid var(--rand); background: var(--karte); font-size: .92rem;
+}
+.chip input:checked + span, .chip-knopf.an {
+  background: var(--haupt); color: var(--haupt-text); border-color: var(--haupt);
+}
+.chip-knopf { cursor: pointer; }
+
+/* --- Formularfelder ---------------------------------------------------- */
+
+input[type=text], input[type=number], select {
+  font: inherit; width: 100%; padding: 13px 14px; margin: 0 0 12px;
+  border: 1px solid var(--rand); border-radius: 14px;
+  background: var(--grund); color: var(--text);
+}
+input[type=number] { width: 6rem; }
+.zeile { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
+.zeile input, .zeile select { margin: 0; }
+.datei {
+  display: block; padding: 14px; border: 1px dashed var(--rand);
+  border-radius: 14px; text-align: center; margin-bottom: 12px; cursor: pointer;
+}
+.datei input { display: none; }
+
+/* --- Listen ------------------------------------------------------------ */
+
+.angebot, .rueckblick, .wissen { list-style: none; padding: 0; margin: 0 0 16px; }
+.angebot li {
+  background: var(--karte); border: 1px solid var(--rand);
+  border-radius: 14px; padding: 13px 16px; margin-bottom: 8px;
+  display: flex; justify-content: space-between; gap: 10px; align-items: baseline;
+}
+.rueckblick li {
+  background: var(--still); border-radius: 14px; padding: 13px 16px;
+  margin-bottom: 8px; font-size: 1.05rem;
+}
+.wissen li {
+  display: flex; align-items: center; gap: 12px;
+  background: var(--karte); border: 1px solid var(--rand);
+  border-radius: 14px; padding: 12px 14px; margin-bottom: 8px;
+}
+.wissen .sym { font-size: 1.3rem; }
+.wissen .txt { flex: 1; }
+.wissen .weg { border: none; background: none; color: var(--leise); padding: 6px 8px; }
+
+/* --- Sammelkarten ------------------------------------------------------ */
+
+.karten { display: flex; flex-wrap: wrap; gap: 10px; }
+.sammelkarte {
+  width: 96px; padding: 12px 8px; text-align: center;
+  background: var(--karte); border: 1px solid var(--rand); border-radius: 16px;
+}
+.sammelkarte img, .sammelkarte span {
+  display: block; width: 56px; height: 56px; margin: 0 auto 8px;
+  border-radius: 50%; object-fit: cover; font-size: 32px; line-height: 56px;
+}
+.sammelkarte b { font-size: .8rem; font-weight: 600; }
+.sammelkarte.gross { width: auto; padding: 22px; margin: 14px 0; }
+.sammelkarte.gross img, .sammelkarte.gross span {
+  width: 84px; height: 84px; line-height: 84px; font-size: 46px;
+}
+
+/* --- Uhr (Speedrun / Timer) -------------------------------------------- */
+
+.uhr {
+  font-size: 3rem; font-variant-numeric: tabular-nums; font-weight: 600;
+  margin: 16px 0 8px; letter-spacing: .02em;
+}
+.bestzeit { color: var(--leise); font-size: .9rem; }
+.spaeter { margin-top: 18px; }
+video { width: 100%; border-radius: 14px; margin-top: 12px; }
+
+/* --- Sonstiges --------------------------------------------------------- */
+
+.sagt {
+  background: var(--still); border-radius: 14px; padding: 12px 16px;
+  margin-bottom: 16px; text-align: center;
+}
+.fokus { font-size: 1.15rem; font-weight: 600; margin-bottom: .3rem; }
+.termin { background: var(--still); border-radius: 14px; padding: 13px 16px; }
+.neuer-schritt { font-size: 1.15rem; font-weight: 600; margin: 12px 0; }
+.planbild { width: 100%; border-radius: 16px; border: 1px solid var(--rand); margin-bottom: 14px; }
+.notruf { display: flex; justify-content: space-between; align-items: center;
+          margin-top: 22px; font-size: .9rem; }
+.notruf a { color: var(--leise); }
+
+table.plan { width: 100%; border-collapse: collapse; font-size: .9rem; margin-bottom: 12px; }
+table.plan th, table.plan td { padding: 6px 2px; text-align: center; }
+table.plan td:first-child, table.plan th:first-child { text-align: left; }
+.haken input { width: 22px; height: 22px; }
+
+/* --- Eltern ------------------------------------------------------------ */
+
+main.eltern { max-width: 30rem; }
+.zustand {
+  background: var(--karte); border: 1px solid var(--rand);
+  border-radius: var(--radius); padding: 18px; margin: 16px 0;
+}
+.zustand h2 { margin: 0 0 .3rem; font-size: 1.2rem; }
+.gemacht { font-size: 1.05rem; }
+.satz { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
+.satz button { min-width: 44px; }
+.satz button.an { background: var(--haupt); color: var(--haupt-text); border-color: var(--haupt); }
+.regeln { margin-top: 24px; color: var(--leise); font-size: .9rem; }
+.regeln ul { padding-left: 1.1rem; }
+
+/* --- Untere Leiste ----------------------------------------------------- */
+
+nav.unten {
+  position: fixed; left: 0; right: 0; bottom: 0; z-index: 10;
+  display: flex; background: var(--karte); border-top: 1px solid var(--rand);
+  padding-bottom: env(safe-area-inset-bottom, 0);
+}
+nav.unten a {
+  flex: 1; text-align: center; padding: 9px 2px 10px; text-decoration: none;
+  color: var(--leise); font-size: .68rem; line-height: 1.3;
+}
+nav.unten a b { display: block; font-size: 1.32rem; font-weight: 400; }
+nav.unten a.on { color: var(--haupt); }
+
+@media (min-width: 40rem) {
