--- /dev/null
+++ b/app/templates/woche/notfall.html
@@ -0,0 +1,64 @@
+{% extends "woche/base.html" %}
+{% block title %}Morgen ist was{% endblock %}
+{% block mainclass %}heute{% endblock %}
+
+{% block content %}
+{% if ergebnis %}
+  <div class="heute-karte">
+    {% if ergebnis.schlaf %}
+      <h1>🌙</h1>
+      <p class="gross-text">{{ ergebnis.text }}</p>
+    {% else %}
+      <p class="leise">{{ ergebnis.text }}</p>
+      <h1>{{ ergebnis.schritt.titel }}</h1>
+      <p class="leise">{{ ergebnis.schritt.einstieg }}</p>
+      {% if helfer %}
+        <form method="post" action="/woche/hilfe">
+          {{ csrf_input() }}
+          <input type="hidden" name="frage" value="Morgen ist {{ fach.name if fach }}.">
+          <button type="submit" name="helfer_id" value="{{ helfer[0].id }}"
+                  class="gross haupt">{{ helfer[0].name }} sofort fragen</button>
+        </form>
+      {% endif %}
+      {% if ergebnis.lerneinheit %}
+        <a href="/lernen/{{ ergebnis.lerneinheit }}" class="gross knopf">
+          Karos Erklärung dazu</a>
+      {% endif %}
+      <a href="/woche" class="gross knopf still">okay, ich fang an</a>
+    {% endif %}
+  </div>
+{% else %}
