+{% extends "woche/base.html" %}
+{% block title %}Anpassen{% endblock %}
+{% block mainclass %}heute{% endblock %}
+
+{% block content %}
+<div class="heute-karte">
+  <h1>{{ vorschlag.text }}</h1>
+
+  {% if vorschlag.art == 'kleiner' %}
+    <p class="neuer-schritt">{{ vorschlag.neu.titel }}</p>
+    <form method="post" action="/woche/schritt/{{ schritt.id }}/anpassung">
+      {{ csrf_input() }}
+      <input type="hidden" name="art" value="kleiner">
+      <button type="submit" name="wert" value="annehmen" class="gross haupt">passt</button>
+      <button type="submit" name="wert" value="lassen" class="still">lass so</button>
+    </form>
+
+  {% elif vorschlag.art == 'zeitpunkt' %}
+    <form method="post" action="/woche/schritt/{{ schritt.id }}/anpassung"
+          class="liste">
+      {{ csrf_input() }}
+      <input type="hidden" name="art" value="zeitpunkt">
+      {% for o in vorschlag.optionen %}
+        <button type="submit" name="wert" value="{{ o }}" class="gross still">{{ o }}</button>
+      {% endfor %}
+    </form>
+
+  {% elif vorschlag.art == 'strategie' %}
+    <div class="liste">
+      <form method="post" action="/woche/schritt/{{ schritt.id }}/anpassung">
+        {{ csrf_input() }}
+        <input type="hidden" name="art" value="ruhen">
+        <button type="submit" class="gross still">diese Woche ruhen lassen</button>
+      </form>
+      <a href="/woche/hilfe" class="gross knopf">jemanden fragen</a>
+      <a href="/woche/plan" class="gross knopf still">anderen Schritt wählen</a>
+    </div>
+    <p class="leise klein">Deine Eltern bekommen den Hinweis, kurz mit dir zu
+      reden. Du siehst das hier — es passiert nichts hinter deinem Rücken.</p>
+
+  {% else %}
+    <form method="post" action="/woche/schritt/{{ schritt.id }}/anpassung">
+      {{ csrf_input() }}
+      <input type="hidden" name="art" value="kurz">
+      <button type="submit" name="wert" value="annehmen" class="gross haupt">okay</button>
+      <button type="submit" name="wert" value="lassen" class="still">lass so</button>
+    </form>
+  {% endif %}
+</div>
+{% endblock %}
diff --git a/app/templates/woche/base.html b/app/templates/woche/base.html
new file mode 100644
index 0000000..687e44c
--- /dev/null
+++ b/app/templates/woche/base.html
@@ -0,0 +1,46 @@
+<!doctype html>
+<html lang="de">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+  <meta name="referrer" content="same-origin">
+  <title>{% block title %}Meine Woche{% endblock %}</title>
+  <link rel="stylesheet" href="/static/woche.css?v={{ asset_version|default('0') }}">
+  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><text y='13' font-size='13'>🧸</text></svg>">
+</head>
+<body>
+
+{% macro csrf_input() -%}
+<input type="hidden" name="{{ csrf_field }}" value="{{ csrf }}">
+{%- endmacro %}
+
+{% macro ding_bild(klasse='avatar') -%}
+  {% if ding and ding.bild %}
+    <img class="{{ klasse }}" src="/woche/bild/{{ ding.bild }}" alt="">
+  {% else %}
+    <span class="{{ klasse }} platzhalter">{{ formen.get(ding.form if ding else 'einfach', {}).get('symbol', '🧸') }}</span>
+  {% endif %}
+{%- endmacro %}
+
+<main class="{% block mainclass %}{% endblock %}">
+  {% if sagt %}<p class="sagt">{{ sagt }}</p>{% endif %}
+  {% block content %}{% endblock %}
+</main>
+
+{% if nav|default(true) %}
+<nav class="unten">
+  <a href="/woche" class="{{ 'on' if path == '/woche' or path == '/woche/' }}">
+    <b>☀️</b><span>Heute</span></a>
+  <a href="/woche/plan" class="{{ 'on' if path.startswith('/woche/plan') }}">
+    <b>🗒</b><span>Woche</span></a>
+  <a href="/woche/hilfe" class="{{ 'on' if path.startswith('/woche/hilfe') }}">
+    <b>🤝</b><span>Hilfe</span></a>
+  <a href="/woche/ueber-dich" class="{{ 'on' if path.startswith('/woche/ueber') }}">
+    <b>💭</b><span>Über dich</span></a>
+  <a href="/woche/stundenplan" class="{{ 'on' if path.startswith('/woche/stundenplan') }}">
+    <b>📅</b><span>Plan</span></a>
+</nav>
+{% endif %}
+
+</body>
+</html>
diff --git a/app/templates/woche/einrichtung.html b/app/templates/woche/einrichtung.html
new file mode 100644
index 0000000..cf718f0
--- /dev/null
+++ b/app/templates/woche/einrichtung.html
@@ -0,0 +1,84 @@
+{% extends "woche/base.html" %}
+{% block title %}Einrichtung{% endblock %}
+{% block content %}
+
+<h1>Drei Minuten, dann geht's los</h1>
+
+<!-- 1 ------------------------------------------------------------------ -->
+<form method="post" action="/woche/einrichtung/faecher" class="karte {{ 'fertig' if schritt > 1 }}">
+  {{ csrf_input() }}
+  <h2>1 · Deine Fächer</h2>
+  <p class="leise">Hak an, was du hast.</p>
+  <div class="chips">
+    {% for name in standard %}
+      <label class="chip">
+        <input type="checkbox" name="fach" value="{{ name }}"
+               {{ 'checked' if name in faecher|map(attribute='name')|list }}>
+        <span>{{ name }}</span>
+      </label>
+    {% endfor %}
+  </div>
+  <label class="zeile">Klasse
+    <input type="number" name="klasse" min="1" max="13"
+           value="{{ kind.klasse if kind else 6 }}">
+  </label>
+  <button type="submit" class="still">speichern</button>
+  <p class="leise klein">Später kannst du auf „Plan" auch den Stundenplan
+    fotografieren.</p>
+</form>
+
+<!-- 2 ------------------------------------------------------------------ -->
+<form method="post" action="/woche/einrichtung/ding" enctype="multipart/form-data"
+      class="karte {{ 'fertig' if schritt > 2 }}">
+  {{ csrf_input() }}
+  <h2>2 · Mein Ding</h2>
+  <p class="leise">Was ist gerade dein Ding?</p>
+  <input type="text" name="wort" maxlength="40"
+         placeholder="z. B. Jellycats, Fußball, Minecraft">
+  <p class="leise">Und was machst du damit?</p>
+  <div class="chips">
+    {% for key, f in formen.items() %}
+      <label class="chip">
+        <input type="radio" name="form" value="{{ key }}"
+               {{ 'checked' if key == 'einfach' }}>
+        <span>{{ f.symbol }} {{ f.label }}</span>
+      </label>
+    {% endfor %}
+  </div>
+  <label class="datei">📷 Zeig's mir
+    <input type="file" name="bild" accept="image/*">
+  </label>
+  <button type="submit" class="still">speichern</button>
+  <p class="leise klein">Dein eigenes Foto — dein Kuscheltier, dein Trikot,
+    dein Poster. Es bleibt auf diesem Rechner.</p>
+</form>
+
+<!-- 3 ------------------------------------------------------------------ -->
+<form method="post" action="/woche/einrichtung/helfer" class="karte">
+  {{ csrf_input() }}
+  <h2>3 · Wer hilft dir?</h2>
+  {% if helfer %}
+    <ul class="angebot">
+      {% for h in helfer %}<li><b>{{ h.name }}</b>
+        {% if h.fester_tag %}<span class="leise">{{ tage[h.fester_tag] }}
+          {{ h.feste_zeit or '' }}</span>{% endif %}</li>{% endfor %}
+    </ul>
+  {% endif %}
+  <input type="text" name="name" maxlength="40"
+         placeholder="z. B. Mama, Lena, Tim">
+  <label class="zeile">Feste Zeit
+    <select name="fester_tag">
+      <option value="0">— keine —</option>
+      {% for t in range(1, 8) %}<option value="{{ t }}">{{ tage[t] }}</option>{% endfor %}
+    </select>
+    <input type="text" name="feste_zeit" maxlength="10" placeholder="18:00">
+  </label>
+  <div class="knopfreihe">
+    <button type="submit" class="still">noch jemand</button>
+    <button type="submit" name="fertig" value="1" class="gross haupt">fertig</button>
+  </div>
+  <p class="leise klein">Eine feste Zeit heißt: du musst nicht fragen. Der
+    Termin ist schon da.</p>
+</form>
+
+{% endblock %}
diff --git a/app/templates/woche/eltern.html b/app/templates/woche/eltern.html
new file mode 100644
index 0000000..38f54f7
--- /dev/null
+++ b/app/templates/woche/eltern.html
@@ -0,0 +1,96 @@
+{% extends "woche/base.html" %}
+{% set nav = false %}
+{% block title %}Meine Woche — für Eltern{% endblock %}
+{% block mainclass %}eltern{% endblock %}
+
+{% block content %}
+{% set z = zusammenfassung %}
+
+{% if zusagen|length < 3 %}
+  <div class="karte zusage">
+    <h1>Bevor Sie hineinschauen</h1>
+    <p>Drei Sätze. Jeden einzeln bestätigen — ohne sie ist dieses Dashboard ein
+      Kontrollwerkzeug, egal wie freundlich es formuliert ist.</p>
+    {% for nr, satz in [
+        (1, 'Ich frage nicht nach, was erledigt wurde.'),
+        (2, 'Ich halte meinen festen Termin ein, auch wenn nichts anliegt.'),
+        (3, 'Wenn mein Kind eine Woche nichts macht, spreche ich es nicht auf die App an.')] %}
+      <form method="post" action="/woche/eltern/zusage" class="satz">
+        {{ csrf_input() }}
+        <input type="hidden" name="nr" value="{{ nr }}">
+        <button type="submit" class="{{ 'an' if nr in zusagen }}" {{ 'disabled' if nr in zusagen }}>
+          {{ '✓' if nr in zusagen else '○' }}</button>
+        <span>{{ satz }}</span>
+      </form>
+    {% endfor %}
+  </div>
+{% else %}
+
+  <h1>Diese Woche</h1>
+  {% if z.fokus %}<p class="fokus">🎯 {{ z.fokus }}</p>{% endif %}
+
+  {% if z.gemacht %}
+    <p class="gemacht">✓ {{ z.gemacht|join(', ') }}</p>
+  {% endif %}
+  {% if z.stimmung %}<p class="leise">🙂 {{ z.stimmung }}</p>{% endif %}
+
+  <div class="zustand">
+    <h2>{{ z.titel }}</h2>
+    <p>{{ z.impuls }}</p>
+  </div>
+
+  {% if termin %}
+    <p class="termin">👤 Ihr fester Termin: {{ tage[termin.fester_tag] }}
+      {{ termin.feste_zeit or '' }} — {{ termin.name }}</p>
+  {% endif %}
+
+  {% if freigaben %}
+    <div class="karte">
+      <h2>Kurz bestätigen</h2>
+      {% for d in freigaben %}
+        <form method="post" action="/woche/eltern/freigabe/{{ d.id }}" class="satz">
+          {{ csrf_input() }}
+          <span>Ihr Kind möchte <b>{{ d.wort }}</b> als sein Ding.</span>
+          <button type="submit" name="ja" value="1">ja</button>
+          <button type="submit">lieber nicht</button>
+        </form>
+      {% endfor %}
+      <p class="leise klein">Solange nichts bestätigt ist, läuft die App
+        weiter — sie sagt dann nur die Form statt des Wortes.</p>
+    </div>
+  {% endif %}
+
+  <div class="karte">
+    <h2>Karo mitlesen</h2>
+    <p class="leise">Der Begleiter kann Karos Themen und den Arbeitstermin
+      mitlesen{% if karo_fach %} — für {{ karo_fach }}{% endif %}. Dann steht im
+      Angebot der Name der Lücke statt einer allgemeinen Formulierung, und der
+      Wochenanker wird aus dem letzten eingelesenen Blatt vorgeschlagen.
+      Er schreibt dabei nichts in Karo zurück.</p>
+    <form method="post" action="/woche/eltern/bruecke">
+      {{ csrf_input() }}
+      {% if bruecke_an %}
+        <button type="submit" class="still">ausschalten</button>
+        <span class="leise klein">ist an</span>
+      {% else %}
+        <button type="submit" name="an" value="1" class="still">einschalten</button>
+        <span class="leise klein">ist aus</span>
+      {% endif %}
+    </form>
+  </div>
+
+  <details class="regeln">
+    <summary>Wie entsteht das?</summary>
+    <ul>
+      {% for key, text in regeln_liste %}
+        <li><b>{{ key }}</b> — {{ text }}</li>
+      {% endfor %}
+    </ul>
+    <p class="leise klein">Es gibt keine weitere Stufe, keine Farbe, keine
+      Quote und keine Liste des Liegengebliebenen. Sie sehen keine einzelnen
+      Tagesrückmeldungen, keine Gründe, keine Uhrzeiten und nicht, welche
+      Fächer Ihr Kind meidet. Eine Stimmung erscheint erst, wenn es
+        dafür mehr als eine Rückmeldung gibt.</p>
+  </details>
+{% endif %}
+{% endblock %}
diff --git a/app/templates/woche/form.html b/app/templates/woche/form.html
new file mode 100644
index 0000000..56efe8e
--- /dev/null
+++ b/app/templates/woche/form.html
@@ -0,0 +1,54 @@
+{% extends "woche/base.html" %}
+{% block title %}{{ formen.get(schritt.form, {}).get('label', 'Los') }}{% endblock %}
+{% block mainclass %}heute{% endblock %}
+
+{% block content %}
+<div class="heute-karte" id="formkarte"
+     data-form="{{ schritt.form }}" data-minuten="{{ minuten }}">
+  {{ ding_bild('avatar') }}
+  <p class="fach">{{ schritt.fach_name or '' }}</p>
+  <h1>{{ schritt.titel }}</h1>
+
+  {% if schritt.form == 'speedrun' %}
+    <p class="leise">{{ formen.speedrun.hinweis }}</p>
+    {% if bestzeit %}<p class="bestzeit">Deine Bestzeit: {{ bestzeit }} s</p>{% endif %}
+    <div class="uhr" id="uhr">0,0</div>
+    <button type="button" class="gross haupt" id="startknopf">Start</button>
+    <form method="post" action="/woche/schritt/{{ schritt.id }}/bestzeit" id="zeitform">
+      {{ csrf_input() }}
+      <input type="hidden" name="sekunden" id="sekunden" value="0">
+      <button type="submit" class="gross still" id="fertigknopf" hidden>fertig</button>
+    </form>
+
+  {% elif schritt.form == 'clip' %}
+    <p class="leise">{{ formen.clip.hinweis }}</p>
+    <div class="uhr" id="uhr">60</div>
+    <button type="button" class="gross haupt" id="clipknopf">Aufnehmen</button>
+    <video id="vorschau" playsinline controls hidden></video>
+    <p class="leise klein">Bleibt auf deinem Gerät. Nichts wird hochgeladen.</p>
+    <form method="post" action="/woche/schritt/{{ schritt.id }}/rueckmeldung" class="spaeter">
+      {{ csrf_input() }}
+      <input type="hidden" name="wert" value="okay">
+      <button type="submit" class="still">fertig</button>
+    </form>
+
+  {% else %}
+    <p class="leise">{{ formen.einfach.hinweis }}</p>
+    <div class="uhr" id="uhr">{{ minuten }}:00</div>
+    <button type="button" class="gross haupt" id="startknopf">Start</button>
+    <form method="post" action="/woche/schritt/{{ schritt.id }}/rueckmeldung" class="spaeter">
+      {{ csrf_input() }}
+      <input type="hidden" name="wert" value="okay">
+      <button type="submit" class="still">fertig</button>
+    </form>
+  {% endif %}
+</div>
+
+{% if lerneinheit %}
+  <p class="leise klein">Karo hat zu „{{ thema }}" schon eine Erklärung.
+    <a href="/lernen/{{ lerneinheit }}">anschauen</a> — dauert länger als
+    diese Minuten hier.</p>
+{% endif %}
+
+<script src="/static/woche.js?v={{ asset_version }}" defer></script>
+{% endblock %}
diff --git a/app/templates/woche/grund.html b/app/templates/woche/grund.html
